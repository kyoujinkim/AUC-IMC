{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-context.schema.json",
  "title": "Editable consensus user context",
  "type": "object",
  "required": [
    "schema_version",
    "user_context_version",
    "research_run_id",
    "preferences",
    "notes",
    "evidence_inputs",
    "request_responses"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "user_context_version": {"type": "integer", "minimum": 1},
    "research_run_id": {"type": "string", "minLength": 1},
    "preferences": {"type": "object"},
    "notes": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "evidence_inputs": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "request_responses": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
