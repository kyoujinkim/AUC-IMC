{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-context.schema.json",
  "title": "Consensus research context",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "snapshot_dates",
    "provenance",
    "methodology",
    "sectors",
    "validation_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshot_dates": {
      "type": "object",
      "required": ["old", "new"],
      "additionalProperties": false,
      "properties": {
        "old": {"type": "string", "format": "date"},
        "new": {"type": "string", "format": "date"}
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "kind": {"type": "string"},
          "as_of_date": {"type": "string", "format": "date"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "methodology": {"$ref": "#/$defs/factObject"},
    "market": {"$ref": "#/$defs/factObject"},
    "sectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/sector"}
    },
    "validation_summary": {"$ref": "#/$defs/factObject"}
  },
  "$defs": {
    "factValue": {
      "anyOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/factValue"}},
        {"$ref": "#/$defs/factObject"}
      ]
    },
    "factObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^(?:(?:[Rr][Ii][Ss][Kk][Ss]?|[Ii][Nn][Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ii][Oo][Nn][Ss]?|[Rr][Ee][Cc][Oo][Mm][Mm][Ee][Nn][Dd][Aa][Tt][Ii][Oo][Nn][Ss]?|[Ss][Tt][Aa][Nn][Cc][Ee][Ss]?|[Rr][Aa][Tt][Ii][Nn][Gg][Ss]?|[Dd][Ee][Cc][Ii][Ss][Ii][Oo][Nn][Ss]?|[Dd][Ii][Rr][Ee][Cc][Tt][Ii][Oo][Nn][Ss]?|[Dd][Rr][Ii][Vv][Ee][Rr][Ss]?|[Cc][Aa][Uu][Ss][Ee][Ss]?)(?:_.*)?|[Cc][Aa][Uu][Ss][Aa][Ll].*|[Ll][Oo][Nn][Gg](?:_[Ss][Ee][Cc][Tt][Oo][Rr][Ss])?|[Ss][Hh][Oo][Rr][Tt](?:_[Ss][Ee][Cc][Tt][Oo][Rr][Ss])?|[Ww][Aa][Tt][Cc][Hh](?:_[Ss][Ee][Cc][Tt][Oo][Rr][Ss])?|[Tt][Hh][Ee][Ss][Ii][Ss]|[Ii][Mm][Pp][Aa][Cc][Tt]|[Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee]_[Ll][Ee][Dd][Gg][Ee][Rr]|[Dd][Aa][Tt][Aa]_[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ss]|[Uu][Ss][Ee][Rr]_[Oo][Vv][Ee][Rr][Rr][Ii][Dd][Ee][Ss]?)$"
        }
      },
      "additionalProperties": {"$ref": "#/$defs/factValue"}
    },
    "sector": {
      "type": "object",
      "required": ["sector"],
      "additionalProperties": false,
      "properties": {
        "sector": {"type": "string", "minLength": 1},
        "sector_name": {"type": "string"},
        "signals": {"$ref": "#/$defs/factObject"},
        "revisions": {"$ref": "#/$defs/factObject"},
        "forward_revision": {"type": ["number", "null"]},
        "revision_slope": {"type": ["number", "null"]},
        "breadth": {"$ref": "#/$defs/factObject"},
        "company_revision_stats": {"$ref": "#/$defs/factObject"},
        "coverage": {"$ref": "#/$defs/factObject"},
        "growth": {"$ref": "#/$defs/factObject"},
        "denominator_instability_by_horizon": {"$ref": "#/$defs/factObject"},
        "quality_flags": {"$ref": "#/$defs/factObject"},
        "component_values": {"$ref": "#/$defs/factObject"},
        "component_ranks": {"$ref": "#/$defs/factObject"},
        "component_rank_methods": {"$ref": "#/$defs/factObject"},
        "research_prior": {"type": ["number", "null"]},
        "contributions": {"$ref": "#/$defs/factObject"}
      }
    }
  }
}
