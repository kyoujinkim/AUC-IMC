{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-result.schema.json",
  "title": "LLM consensus analysis result",
  "type": "object",
  "required": [
    "schema_version",
    "research_run_id",
    "user_context_version",
    "long_sectors",
    "short_sectors",
    "neutral_sectors",
    "watch_sectors",
    "evidence_ledger",
    "data_requests"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "research_run_id": {"type": "string", "minLength": 1},
    "user_context_version": {"type": "integer", "minimum": 1},
    "long_sectors": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/decision"}
    },
    "short_sectors": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/decision"}
    },
    "neutral_sectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "watch_sectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "evidence_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "data_requests": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataRequest"}
    }
  },
  "$defs": {
    "quantitativeSupport": {
      "type": "object",
      "required": ["metric", "value", "research_json_path"],
      "additionalProperties": false,
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "research_json_path": {"type": "string", "pattern": "^/"},
        "numeric_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "driver": {
      "type": "object",
      "required": ["claim", "status", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "status": {"enum": ["Confirmed", "Corroborated", "Inferred", "Unknown"]},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "driver_category": {"type": "string"},
        "direction": {"type": "string"},
        "horizon": {"type": "string"},
        "affected_entities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "sector",
        "confidence",
        "provisional",
        "thesis",
        "quantitative_support",
        "drivers",
        "evidence_ids",
        "counter_evidence",
        "impact",
        "risks",
        "invalidation_conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "sector": {"type": "string", "minLength": 1},
        "sector_name": {"type": "string"},
        "confidence": {"enum": ["High", "Medium", "Low"]},
        "provisional": {"type": "boolean"},
        "thesis": {"type": "string", "minLength": 1},
        "quantitative_support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/quantitativeSupport"}
        },
        "drivers": {
          "type": "array",
          "items": {"$ref": "#/$defs/driver"}
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "counter_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "impact": {"type": "string", "minLength": 1},
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "invalidation_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "status"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["Confirmed", "Corroborated", "Inferred", "Unknown"]},
        "source": {"type": "string"},
        "url": {"type": "string"},
        "publication_date": {"type": "string", "format": "date"},
        "affected_entities": {"type": "array", "items": {"type": "string"}},
        "driver_category": {"type": "string"},
        "direction": {"type": "string"},
        "horizon": {"type": "string"},
        "claim": {"type": "string"}
      }
    },
    "dataRequest": {
      "type": "object",
      "required": [
        "data_request_id",
        "needed",
        "why",
        "acceptable_formats",
        "blocking_consequence"
      ],
      "additionalProperties": false,
      "properties": {
        "data_request_id": {"type": "string", "minLength": 1},
        "needed": {"type": "string", "minLength": 1},
        "entities": {"type": "array", "items": {"type": "string"}},
        "fields": {"type": "array", "items": {"type": "string"}},
        "date_range": {"type": "string"},
        "why": {"type": "string", "minLength": 1},
        "acceptable_formats": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "blocking_consequence": {"type": "string", "minLength": 1},
        "conclusion_without_it": {"type": "string"},
        "resolved": {"type": "boolean"},
        "response_id": {"type": "string"}
      }
    }
  }
}
